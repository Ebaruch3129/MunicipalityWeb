@page "/register"

<PageTitle>הרשמה | עיר בקשר</PageTitle>
<SiteHeader IsRegister="true" />

<main class="container registration-page py-5" dir="rtl">
    <section class="registration-intro text-center mx-auto mb-4">
        <h1>הרשמה לעיר בקשר</h1>
        <p class="lead text-secondary">פתחו חשבון ותחילו לדווח, לעקוב אחר פניות ולהיות חלק מהשינוי בעיר שלכם.</p>
    </section>

    <div class="row g-4 registration-layout" dir="ltr">
        <div class="col-lg-7 order-2 order-lg-1">
            <CityPreview Register="true" />
        </div>

        <div class="col-lg-5 order-1 order-lg-2" dir="rtl">
            <section class="card border-0 shadow-sm registration-card h-100">
                <div class="card-body p-4">
                    <div class="card-heading mb-4">
                        <h2>פתחו חשבון חדש</h2>
                        <p class="text-secondary">מלאו את הפרטים והתחילו לדווח, לעקוב אחר פניות ולהיות חלק מהשינוי בעיר שלכם.</p>
                    </div>

                    <div class="register-switch bg-light-green rounded-3 p-3 mb-4 d-flex align-items-center justify-content-between gap-3" dir="ltr">
                        <div dir="rtl">
                            <strong>כבר יש לכם חשבון?</strong>
                            <span class="d-block text-secondary small">עברו להתחברות והמשיכו מהמקום שבו הפסקתם.</span>
                        </div>
                        <a class="btn btn-outline-primary flex-shrink-0" href="/signin">התחברות</a>
                    </div>

                    <form class="registration-form" onsubmit="return false;">
                        <div class="mb-3">
                            <label class="form-label" for="register-name">שם מלא</label>
                            <input class="form-control" id="register-name" type="text" autocomplete="name" placeholder="שם פרטי ושם משפחה" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="register-email">כתובת מייל</label>
                            <input class="form-control" id="register-email" type="email" autocomplete="email" placeholder="name@example.com" dir="ltr" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="register-password">סיסמה</label>
                            <input class="form-control" id="register-password" type="password" autocomplete="new-password" placeholder="••••••••" dir="ltr" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label" for="register-confirm">אימות סיסמה</label>
                            <input class="form-control" id="register-confirm" type="password" autocomplete="new-password" placeholder="••••••••" dir="ltr" />
                        </div>
                        <button class="btn btn-primary w-100" type="button">יוצרים חשבון</button>
                        <p class="small text-secondary text-center mt-3 mb-0">על ידי הרשמה, אתם מסכימים לתנאי השימוש ולמדיניות הפרטיות של עיר בקשר.</p>
                    </form>
                </div>
            </section>
        </div>
    </div>
</main>
