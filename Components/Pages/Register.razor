@page "/register"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using Model
@inject HttpClient Http

<PageTitle>הרשמה | עיר בקשר</PageTitle>
<SiteHeader IsRegister="true" />

<main class="registration-content container-fluid" dir="rtl">
    <section class="registration-intro">
        <h1>הרשמה לעיר בקשר</h1>
        <p>פתחו חשבון ותחילו לדווח, לעקוב אחר פניות ולהיות חלק מהשינוי בעיר שלכם.</p>
    </section>

    <div class="registration-layout" dir="ltr">
        <CityPreview Register="true" />

        <section class="auth-card registration-card" dir="rtl">
            <div class="card-heading">
                <h2>פתחו חשבון חדש</h2>
                <p>מלאו את הפרטים והתחילו לדווח, לעקוב אחר פניות ולהיות חלק מהשינוי בעיר שלכם.</p>
            </div>

            <div class="register-switch">
                <div>
                    <strong>כבר יש לכם חשבון?</strong>
                    <span>עברו להתחברות והמשיכו מהמקום שבו הפסקתם.</span>
                </div>
                <a class="btn button button-outline" href="/signin">התחברות</a>
            </div>

            <EditForm Model="Form" OnValidSubmit="CreateAccountAsync" class="auth-form registration-form">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="register-name">שם מלא</label>
                    <InputText class="form-control" id="register-name" @bind-Value="Form.FullName" autocomplete="name" placeholder="שם פרטי ושם משפחה" />
                    <ValidationMessage For="() => Form.FullName" />
                </div>
                <div class="form-field">
                    <label for="register-email">כתובת מייל</label>
                    <InputText class="form-control" id="register-email" @bind-Value="Form.Email" type="email" autocomplete="email" placeholder="name@example.com" dir="ltr" />
                    <ValidationMessage For="() => Form.Email" />
                </div>
                <div class="form-field">
                    <label for="register-password">סיסמה</label>
                    <InputText class="form-control" id="register-password" @bind-Value="Form.Password" type="password" autocomplete="new-password" placeholder="••••••••" dir="ltr" />
                    <ValidationMessage For="() => Form.Password" />
                </div>
                <div class="form-field">
                    <label for="register-confirm">אימות סיסמה</label>
                    <InputText class="form-control" id="register-confirm" @bind-Value="Form.ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" dir="ltr" />
                    <ValidationMessage For="() => Form.ConfirmPassword" />
                </div>

                @if (!string.IsNullOrWhiteSpace(ResultMessage))
                {
                    <p class="form-result @(Succeeded ? "success" : "error")" role="status">@ResultMessage</p>
                }

                <div class="form-actions">
                    <button class="btn button button-primary submit-button" type="submit" disabled="@IsBusy">
                        @(IsBusy ? "יוצרים חשבון…" : "יוצרים חשבון")
                    </button>
                    <p>על ידי הרשמה, אתם מסכימים לתנאי השימוש ולמדיניות הפרטיות של עיר בקשר.</p>
                </div>
            </EditForm>
        </section>
    </div>
</main>

@code {
    private RegistrationForm Form { get; } = new RegistrationForm();
    private bool IsBusy;
    private bool Succeeded;
    private string? ResultMessage;

    private async Task CreateAccountAsync()
    {
        Succeeded = false;
        ResultMessage = null;

        if (Form.Password != Form.ConfirmPassword)
        {
            ResultMessage = "הסיסמאות אינן תואמות. בדקו את שני השדות ונסו שוב.";
            return;
        }

        IsBusy = true;
        try
        {
            string email = Form.Email.Trim();
            string encodedEmail = Uri.EscapeDataString(email);
            using HttpResponseMessage existsResponse = await Http.GetAsync("api/users/email-exists/" + encodedEmail);
            if (!existsResponse.IsSuccessStatusCode)
            {
                ResultMessage = "לא הצלחנו לבדוק את כתובת המייל כרגע. נסו שוב בעוד רגע.";
                return;
            }

            bool? emailExists = await existsResponse.Content.ReadFromJsonAsync<bool>();

            if (emailExists == true)
            {
                ResultMessage = "כתובת המייל כבר רשומה. אפשר להתחבר לחשבון הקיים.";
                return;
            }

            User newUser = new User(Form.FullName.Trim(), email, Form.Password);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/users?roleName=Resident", newUser);

            if (response.StatusCode == HttpStatusCode.Created)
            {
                Succeeded = true;
                ResultMessage = "החשבון נוצר בהצלחה. אפשר להתחבר ולהתחיל לדווח.";
            }
            else if (response.StatusCode == HttpStatusCode.Conflict)
            {
                ResultMessage = "כתובת המייל כבר רשומה. אפשר להתחבר לחשבון הקיים.";
            }
            else
            {
                ResultMessage = "לא הצלחנו ליצור חשבון כרגע. בדקו את הפרטים ונסו שוב.";
            }
        }
        catch (HttpRequestException)
        {
            ResultMessage = "לא הצלחנו להתחבר לשרת כרגע. בדקו שה־API פועל ונסו שוב.";
        }
        catch (TaskCanceledException)
        {
            ResultMessage = "השרת לא הגיב בזמן. נסו שוב בעוד רגע.";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private class RegistrationForm
    {
        [Required(ErrorMessage = "יש להזין שם מלא.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "יש להזין כתובת מייל.")]
        [EmailAddress(ErrorMessage = "כתובת המייל אינה תקינה.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "יש להזין סיסמה.")]
        [MinLength(6, ErrorMessage = "הסיסמה צריכה להכיל לפחות 6 תווים.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "יש לאמת את הסיסמה.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
