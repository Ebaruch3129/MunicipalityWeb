@page "/signin"

<PageTitle>התחברות | עיר בקשר</PageTitle>
<SiteHeader />

<main class="container auth-page py-5" dir="rtl">
    <div class="sign-in-layout mx-auto">
        <section class="auth-intro mb-4">
            <h1>התחברות לעיר בקשר</h1>
            <p class="lead text-secondary">היכנסו לחשבון שלכם כדי לדווח, לעקוב אחר פניות ולהמשיך להשפיע על הסביבה שלכם.</p>
        </section>

        <section class="card border-0 shadow-sm auth-card">
            <div class="card-body p-4 p-md-5">
                <div class="card-heading mb-4">
                    <h2>התחברות</h2>
                    <p class="text-secondary mb-0">הזינו את המייל והסיסמה שלכם כדי להמשיך לעבוד עם החשבון שלכם.</p>
                </div>

                <form class="auth-form" onsubmit="return false;">
                    <div class="mb-3">
                        <label class="form-label" for="signin-email">כתובת מייל</label>
                        <input class="form-control" id="signin-email" type="email" autocomplete="email" placeholder="name@example.com" dir="ltr" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="signin-password">סיסמה</label>
                        <input class="form-control" id="signin-password" type="password" autocomplete="current-password" placeholder="••••••••" dir="ltr" />
                    </div>
                    <div class="d-flex align-items-center gap-4 mb-4" dir="ltr">
                        <a class="link-success text-decoration-none" href="#signin-password">שכחתי סיסמה</a>
                        <div class="form-check d-flex align-items-center gap-2 mb-0" dir="rtl">
                            <input class="form-check-input mt-0" type="checkbox" id="remember-me" />
                            <label class="form-check-label" for="remember-me">זכור אותי</label>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button class="btn btn-primary signin-submit" type="button">התחברות</button>
                    </div>
                </form>
            </div>
        </section>

        <div class="account-switch d-flex align-items-center gap-2 mt-4">
            <span class="text-secondary">עוד לא רשומים?</span>
            <a class="btn btn-outline-primary" href="/register">הרשמה למערכת</a>
        </div>
    </div>
</main>
