@inject NavigationManager Navigation
@inject HttpClient Http
@inject MunicipalityWeb.Services.UserSession UserSession

<header class="site-header">
    <div class="header-actions" dir="rtl">
        @if (UserSession.IsSignedIn)
        {
            <span class="welcome-user">שלום, @UserSession.FullName</span>
            @if (UserSession.IsAdmin)
            {
                <a class="btn button button-primary" href="/admin/open">פניות פתוחות</a>
                <a class="btn button button-outline" href="/admin/map">מפת פניות</a>
                <a class="btn button button-outline" href="/admin/all">כל הפניות</a>
            }
            else
            {
                <a class="btn button button-primary" href="/reports/new">פתיחת בקשה</a>
                <a class="btn button button-outline" href="/reports/mine">הפניות שלי</a>
            }
            <button class="btn button button-outline" type="button" @onclick="SignOutAsync">יציאה</button>
        }
        else if (IsRegister)
        {
            <a class="btn button button-primary" href="/signin">התחברות</a>
            <a class="btn button button-outline" href="/register">הרשמה למערכת</a>
        }
        else
        {
            <a class="btn button button-primary" href="/register">הרשמה למערכת</a>
            <a class="btn button button-outline" href="/signin">התחברות</a>
        }
    </div>

    <nav class="main-nav" aria-label="ניווט ראשי" dir="rtl">
        <a href="/#audience">למי זה מתאים</a>
        <a href="/#how-it-works">איך זה עובד</a>
        <a href="/#capabilities">מה אפשר לעשות</a>
    </nav>

    <a class="brand" href="/" aria-label="עיר בקשר — דף הבית" dir="rtl">
        <span>עיר בקשר</span>
        <span class="brand-mark"><img src="@BrandAsset" alt="" /></span>
    </a>
</header>

@code {
    [Parameter] public bool IsRegister { get; set; }

    private async Task SignOutAsync()
    {
        try
        {
            if (UserSession.IsSignedIn)
            {
                await Http.PostAsync("api/users/logout", null);
            }
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            Http.DefaultRequestHeaders.Authorization = null;
            UserSession.SignOut();
            Navigation.NavigateTo("/");
        }
    }

    private string BrandAsset => Navigation.Uri.Contains("/register", StringComparison.OrdinalIgnoreCase)
        ? "/assets/brand-register.svg"
        : Navigation.Uri.Contains("/signin", StringComparison.OrdinalIgnoreCase)
            ? "/assets/brand-signin.svg"
            : "/assets/brand-landing.svg";
}
