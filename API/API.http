@API_HostAddress = http://localhost:5233
@TestUsername = test-citizen-20261103
@TestEmail = test-citizen-20261103@example.com
@TestEmailEncoded = test-citizen-20261103%40example.com
@TestPassword = ExamplePass123!
@MissingUserId = 99999999

### Weather forecast
GET {{API_HostAddress}}/weatherforecast/
Accept: application/json

### Get all users
GET {{API_HostAddress}}/api/users
Accept: application/json

### Get a user by ID
GET {{API_HostAddress}}/api/users/{{MissingUserId}}
Accept: application/json

### Check whether a username exists
GET {{API_HostAddress}}/api/users/exists/{{TestUsername}}
Accept: application/json

### Check whether an email exists
GET {{API_HostAddress}}/api/users/email-exists/{{TestEmailEncoded}}
Accept: application/json

### Count users by role
GET {{API_HostAddress}}/api/users/count-by-role
Accept: application/json

### Register a test user (run once; change the username and email for another run)
POST {{API_HostAddress}}/api/users?roleName=Student
Content-Type: application/json

{
  "username": "{{TestUsername}}",
  "email": "{{TestEmail}}",
  "password": "{{TestPassword}}"
}

### Log in with the test user created above
POST {{API_HostAddress}}/api/users/login
Content-Type: application/json

{
  "username": "{{TestUsername}}",
  "password": "{{TestPassword}}"
}

### Update role (uses a missing ID so the sample cannot modify a real user)
PUT {{API_HostAddress}}/api/users/{{MissingUserId}}/role?roleName=Teacher

### Update password (uses a missing ID so the sample cannot modify a real user)
PUT {{API_HostAddress}}/api/users/{{MissingUserId}}/password
Content-Type: application/json

"ExampleNewPass123!"

### Update email (uses a missing ID so the sample cannot modify a real user)
PUT {{API_HostAddress}}/api/users/{{MissingUserId}}/email
Content-Type: application/json

"updated-citizen@example.com"

### Delete a user (uses a missing ID so the sample cannot delete a real user)
DELETE {{API_HostAddress}}/api/users/{{MissingUserId}}
